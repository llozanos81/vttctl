<!DOCTYPE html>
<html lang="en" style="--cursor-default: default; --cursor-default-down: default; --cursor-pointer: pointer; --cursor-pointer-down: pointer; --cursor-grab: grab; --cursor-grab-down: grabbing; --cursor-text: text; --cursor-text-down: text;">
<head>
    <title>Foundry VTT Backups</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="../icons/vtt.png">
    <link href="../css/foundry2.css" rel="stylesheet" type="text/css" media="all">
    <style>
        @import "../fonts/fontawesome/css/all.min.css" layer(variables);
    </style>
    <script>
        function refreshPage() {
            setTimeout(function() {
                window.location.reload();
            }, 300000);
        }

            refreshPage();
    </script>
</head>

<body class="auth auth flexcol theme-dark">
    <div id="main-background"></div>
    <header id="main-header" class="flexcol">
        <h1>Foundry VTT Backups</h1>
    </header>
    <table>
        <thead>
        <tr>
        <th>BackupFile</th>
        <th>Version</th>
        <th>Date</th>
        <th>Size</th>
        <th>md5sum</th>
        </tr>
        </thead>
        <tbody>
        {{BACKUP_FILE_TABLE}}
        </tbody>
    </table>
    <h2>Go back to <a href="/setup">setup</a></h2>
    <footer id="watermark" class="flexcol">
        <p id="software-version">VTTctl Version {{VTTCTL_VERSION}}</p>
    </footer>
</body>
</html>
