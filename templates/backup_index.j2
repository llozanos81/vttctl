<!DOCTYPE html>
<html lang="en"{% if major_version | default(13) | int >= 13 %} style="--cursor-default: default; --cursor-default-down: default; --cursor-pointer: pointer; --cursor-pointer-down: pointer; --cursor-grab: grab; --cursor-grab-down: grabbing; --cursor-text: text; --cursor-text-down: text;"{% endif %}>
<head>
    <title>Foundry VTT Backups</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="../icons/vtt.png">
{% if major_version | default(13) | int < 11 %}
    <link href="../fonts/fontawesome/css/all.min.css" rel="stylesheet" type="text/css" media="all">
    <link href="../css/style.css" rel="stylesheet" type="text/css" media="all">
{% else %}
    <link href="../css/foundry2.css" rel="stylesheet" type="text/css" media="all">
    <style>
        @import "../fonts/fontawesome/css/all.min.css" layer(variables);
    </style>
{% endif %}
    <script>
        function refreshPage() {
            setTimeout(function() {
                window.location.reload();
            }, {{ backup_refresh | default(300000) }});
        }

            refreshPage();
    </script>
</head>
{% if major_version | default(13) | int < 11 %}
<body class="vtt setup" style>
    <section id="setup">
<form id="setup-configuration" class="flexcol dark" autocomplete="off">
    <header>
        <h1>Foundry VTT Backups</h1>
    </header>

    <!-- Main Content Section -->
    <section id="config-tabs" class="content flexcol">

        <!-- Backups Tab -->
        <div class="tab active" data-tab="backups" data-group="components">
            <table>
                <thead>
                    <tr>
                        <th>BackupFile</th>
                        <th>Version</th>
                        <th>Date</th>
                        <th>Size</th>
                        <th>md5sum</th>
                        </tr>
                </thead>
                <tbody>
                   {{ backup_file_table }}
                </tbody>
            </table>
        </div>
            <footer class="setup-footer flexrow">
                <h2>Go back to <a class="install-package" href="/setup">setup</a>.</h2>
            </footer>
    </section>
</form>
</section>
    <footer class="watermark">
        VTTctl Version {{ vttctl_version }}
    </footer>
{% else %}
<body{% if major_version | default(13) | int >= 13 %} class="auth auth flexcol theme-dark"{% endif %}>
{% if major_version | default(13) | int >= 13 %}
    <div id="main-background"></div>
    <header id="main-header" class="flexcol">
        <h1>Foundry VTT Backups</h1>
    </header>
{% endif %}
    <table>
        <thead>
        <tr>
        <th>BackupFile</th>
        <th>Version</th>
        <th>Date</th>
        <th>Size</th>
        <th>md5sum</th>
        </tr>
        </thead>
        <tbody>
        {{ backup_file_table }}
        </tbody>
    </table>
    <h2>Go back to <a href="/setup">setup</a></h2>
    <footer{% if major_version | default(13) | int >= 13 %} id="watermark" class="flexcol"{% else %} class="watermark"{% endif %}>
        <p{% if major_version | default(13) | int >= 13 %} id="software-version"{% endif %}>VTTctl Version {{ vttctl_version }}</p>
    </footer>
{% endif %}
</body>
</html>